# Modèle de configuration de SHELVED.
# Copie ce fichier en ".env" puis remplis les vraies valeurs.
# (Le vrai .env n'est jamais commité sur Git.)

# Génère une clé avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplace-moi-par-une-cle-aleatoire

# Durée de validité d'un jeton de connexion, en minutes (1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clé API Google Books (OPTIONNELLE). Laisse vide pour commencer sans clé.
# Pour en obtenir une (gratuite) : console Google Cloud > activer "Books API" > créer une clé.
GOOGLE_BOOKS_API_KEY=

# Cloudinary (stockage des images). Copie la "CLOUDINARY_URL" depuis ton dashboard.
# Format : cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Google Gemini (IA). Clé gratuite à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Nombre max d'appels IA par utilisateur et par jour.
AI_DAILY_LIMIT=20

# Resend (envoi d'emails). Clé gratuite à créer sur https://resend.com (Dashboard > API Keys).
# Sans domaine vérifié, les emails ne peuvent partir que vers l'adresse du compte Resend.
RESEND_API_KEY=

# Adresse du frontend (pour les liens dans les emails). Ne change qu'en production.
FRONTEND_URL=http://localhost:5173
